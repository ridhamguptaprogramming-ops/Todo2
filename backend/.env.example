MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/event-attendance?retryWrites=true&w=majority
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRY=7d

# Email Configuration (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@eventattendance.com
SMTP_FROM_NAME=Event Attendance

# Application
APP_NAME=Event Attendance
APP_URL=http://localhost:5000
VERIFICATION_EXPIRY=24h

# Admin Panel
ADMIN_EMAIL=admin@eventattendance.com